{
  "name": "saixun-web-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:workbuddy": "vite build --mode workbuddy",
    "workbuddy:install": "node scripts/workbuddy-install.mjs",
    "workbuddy:start": "node scripts/workbuddy-start.mjs",
    "preview": "vite preview",
    "test:app": "node --test tests/app-state.test.mjs tests/sidebar-state.test.mjs tests/password-hash-utils.test.mjs",
    "test:pages": "npm run build && node --test tests/pages-build.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
