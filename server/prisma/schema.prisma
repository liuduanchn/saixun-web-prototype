// 赛训智舱 数据库模型 (Prisma + SQLite)
// P0.2：完整建模业务、评分、作品、诊断、答辩、资源、学习、通知等实体。
// 多租户以 Tenant 为隔离根；所有业务表均带 tenantId 或经 Project 间接归属。
//
// ── workbuddyDeploy 分支说明 ─────────────────────────────────────────────
// 本分支用于把整个应用自包含地部署到 WorkBuddy 托管沙箱（单端口 + 内置 SQLite）。
// Prisma 6 的 SQLite 连接器不支持 enum / Json / 标量列表（String[]），因此：
//   · 原 6 个 enum 一律降级为 String，取值保持全大写字面量不变；
//   · 原 Json 字段（settings / transcript / evaluations / payload）改为 String，
//     以 JSON 文本存取，序列化边界统一收口到 src/common/json.ts；
//   · 原 String[]（abilityTags / tags）改为 String，存 JSON 数组文本。
// 类型层面的枚举替身见 src/common/enums.ts。
// SQLite 为单文件库，url 用字面量而非 env("DATABASE_URL")，
// 路径相对于本文件所在目录解析 → server/prisma/saixun.db。
// ────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./saixun.db"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  // 租户级配置（JSON 文本）：如语音识别 ASR 的 asrApiKey / asrEndpoint / asrHeaderName
  settings  String?
  users     User[]
  projects  Project[]
  members   Membership[]

  @@index([name])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 原 enum Role：OWNER | TEACHER | STUDENT | MEMBER
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  activeTenantId String   @default("")
  username       String
  passwordHash   String
  name           String
  // 原 enum Role
  role           String   @default("STUDENT")
  createdAt      DateTime @default(now())

  ownedTasks       Task[]          @relation("TaskOwner")
  uploads          WorkVersion[]
  notifications    Notification[]
  learningEvents   LearningEvent[]
  memberships      Membership[]
  refreshTokens    RefreshToken[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([activeTenantId])
}

model Project {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  competition  String
  // 原 enum Stage：UNDERSTAND | DESIGN | PROTOTYPE | POLISH | DEFENSE | REVIEW
  currentStage String   @default("UNDERSTAND")
  createdAt    DateTime @default(now())

  criteria         Criterion[]
  tasks            Task[]
  works            WorkVersion[]
  defenseSessions  DefenseSession[]
  resources        Resource[]

  @@index([tenantId])
}

model Criterion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  weight    Float
  scorePoints ScorePoint[]

  @@index([projectId])
}

model ScorePoint {
  id          String   @id @default(cuid())
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id])
  name        String
  // 原 String[]：以 JSON 数组文本存取，出口统一经 parseStrArray 还原
  abilityTags String   @default("[]")

  tasks     Task[]      @relation("TaskScorePoints")
  diagnoses Diagnosis[]

  @@index([criterionId])
}

model Task {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  ownerId   String?
  owner     User?      @relation("TaskOwner", fields: [ownerId], references: [id])
  dueDate   DateTime?
  // 原 enum TaskStatus：TODO | IN_PROGRESS | IN_REVIEW | NEEDS_FIX | DONE
  status    String     @default("TODO")
  done      Boolean    @default(false)
  scorePoints ScorePoint[] @relation("TaskScorePoints")
  createdAt DateTime   @default(now())

  @@index([projectId])
}

model WorkVersion {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  fileRef    String
  content    String?  // 上传文件抽取出的纯文本，供诊断/解析比对
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  diagnoses Diagnosis[]

  @@index([projectId])
}

model Diagnosis {
  id            String         @id @default(cuid())
  workVersionId String
  workVersion   WorkVersion    @relation(fields: [workVersionId], references: [id])
  scorePointId  String
  scorePoint    ScorePoint     @relation(fields: [scorePointId], references: [id])
  matchScore    Float
  // 原 enum Severity：LOW | MEDIUM | HIGH | CRITICAL
  severity      String
  issues        String
  suggestions   String
  // 原 enum DiagnosisStatus：PENDING | CONFIRMED | REJECTED
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())

  @@index([workVersionId])
}

model DefenseSession {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  round      Int      @default(1)
  // 原 Json：对话记录，以 JSON 文本存取
  transcript String
  // 原 Json：评分与轮次状态，以 JSON 文本存取
  evaluations String
  createdAt  DateTime @default(now())
  title     String?

  @@index([projectId])
}

model Resource {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  // 原 enum ResourceType：TEMPLATE | CASE | QUESTION_BANK | MATERIAL
  type        String       @default("MATERIAL")
  name        String
  description String?
  fileRef     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
}

model LearningEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  // 原 Json：事件载荷，以 JSON 文本存取
  payload   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String
  title     String
  detail    String?
  targetNav String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// 案例沉淀库：用于检索增强生成（RAG）。
// 注意：原实现注释提到 Postgres 全文检索，但实际检索走 Prisma findMany（无原生 SQL），
// 因此迁移到 SQLite 无需改写查询。
model CaseLibrary {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  category  String   @default("通用")
  // 原 String[]：以 JSON 数组文本存取
  tags      String   @default("[]")
  projectId String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
}

// 刷新令牌：持久化存储，支持主动失效（登出 / 改密踢下线）。
// access_token 短期有效，refresh_token 长期有效且可轮换。
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique // 随机生成的刷新令牌原文
  userId    String
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime? // 非空表示已失效
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 平台级单例配置（2026-10-05 新增，对应权威版方案的方案 B1）。
// 全库仅一行，id 固定为 'platform'，由代码显式写入，故不设列默认值。
// 为什么不复用 Tenant.settings：
//   WorkBuddy 发布平台只注入 PORT，没有环境变量/密钥注入入口；而大模型配置
//   是全站唯一一份（平台级），放在租户表里会被租户级接口越权改写。
// settings 与 Tenant.settings 同策略：SQLite 无 Json 类型，以 JSON 文本存取，
// 序列化边界统一收口到 src/common/json.ts。
model SystemConfig {
  id        String   @id
  settings  String?
  updatedAt DateTime @updatedAt @default(now())
}
