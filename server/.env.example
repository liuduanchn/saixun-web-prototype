# 服务器端口
PORT=3001

# PostgreSQL 连接串（Railway / Supabase / 本地）
# 例：postgresql://user:password@host:5432/saixun?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/saixun?schema=public"

# JWT 配置（生产环境务必替换为强随机值）
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# AI 提供方（OpenAI 兼容接口，可切换 DeepSeek / 通义 / 本地等）
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# 对象存储（Railway Volume 起步，后续可换 R2 / Supabase Storage）
STORAGE_DIR="./uploads"
