# 服务器端口
PORT=3001

# 数据库连接串
# schema 的 provider 为 sqlite，故用文件路径（相对 server/prisma/ 目录）。
# 该文件会随 npm run workbuddy:install 一起上传，故绝不可写入任何密钥。
DATABASE_URL="file:./saixun.db"

# JWT 配置（生产环境务必替换为强随机值）
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# AI 提供方（OpenAI 兼容接口，可切换 DeepSeek / 通义 / 本地等）
# 留空则 AI 功能自动降级为确定性启发式，功能闭环仍完整。
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# 上传目录（沙箱内需可写）
STORAGE_DIR="./uploads"
